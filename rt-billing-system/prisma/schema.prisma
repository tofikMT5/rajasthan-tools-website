generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CASHIER
  SALESMAN
  VIEWER
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  email        String?       @unique
  passwordHash String
  fullName     String
  phone        String?
  photo        String?
  role         Role          @default(CASHIER)
  isActive     Boolean       @default(true)
  lastLogin    DateTime?
  failedLogins Int           @default(0)
  lockedUntil  DateTime?
  createdBy    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  invoices     Invoice[]
  activities   ActivityLog[]
}

model Category {
  id            String     @id @default(cuid())
  nameEn        String
  nameAr        String
  slug          String     @unique
  icon          String?
  image         String?
  parentId      String?
  parent        Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: SetNull)
  children      Category[] @relation("SubCategories")
  showOnWebsite Boolean    @default(true)
  sortOrder     Int        @default(0)
  products      Product[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Brand {
  id            String    @id @default(cuid())
  name          String    @unique
  logo          String?
  showOnInvoice Boolean   @default(false)
  products      Product[]
  createdAt     DateTime  @default(now())
}

model Product {
  id             String          @id @default(cuid())
  itemCode       String          @unique
  barcode        String?         @unique
  nameEn         String
  nameAr         String
  descriptionEn  String?
  descriptionAr  String?
  categoryId     String
  category       Category        @relation(fields: [categoryId], references: [id])
  brandId        String?
  brand          Brand?          @relation(fields: [brandId], references: [id])
  model          String?
  unit           String          @default("PCS")
  costPrice      Decimal         @default(0) @db.Decimal(12, 3)
  salePrice      Decimal         @db.Decimal(12, 3)
  wholesalePrice Decimal?        @db.Decimal(12, 3)
  stockQty       Int             @default(0)
  minStockAlert  Int             @default(5)
  images         String[]        @default([])
  specifications Json?
  warranty       String?
  origin         String?
  supplierId     String?
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  showOnWebsite  Boolean         @default(true)
  isFeatured     Boolean         @default(false)
  status         String          @default("ACTIVE")
  createdBy      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  invoiceItems   InvoiceItem[]
  stockMovements StockMovement[]

  @@index([categoryId])
  @@index([itemCode])
  @@index([barcode])
}

model Customer {
  id             String    @id @default(cuid())
  nameEn         String
  nameAr         String?
  phone          String
  altPhone       String?
  email          String?
  companyName    String?
  civilId        String?
  address        String?
  addressAr      String?
  area           String?
  type           String    @default("RETAIL")
  creditLimit    Decimal   @default(0) @db.Decimal(12, 3)
  openingBalance Decimal   @default(0) @db.Decimal(12, 3)
  currentBalance Decimal   @default(0) @db.Decimal(12, 3)
  tradeLicense   String?
  photo          String?
  notes          String?
  referredBy     String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  invoices       Invoice[]

  @@index([phone])
  @@index([nameEn])
}

model Supplier {
  id        String     @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  balance   Decimal    @default(0) @db.Decimal(12, 3)
  createdAt DateTime   @default(now())
  products  Product[]
  purchases Purchase[]
}

model Invoice {
  id                String        @id @default(cuid())
  invoiceNo         Int           @unique
  type              String        @default("CASH")
  customerId        String?
  customer          Customer?     @relation(fields: [customerId], references: [id])
  customerNameSnap  String
  customerPhoneSnap String?
  dateTime          DateTime      @default(now())
  narration         String?
  salesmanId        String?
  salesman          User?         @relation(fields: [salesmanId], references: [id])
  grossAmount       Decimal       @db.Decimal(12, 3)
  discountAmount    Decimal       @default(0) @db.Decimal(12, 3)
  extraAmount       Decimal       @default(0) @db.Decimal(12, 3)
  netAmount         Decimal       @db.Decimal(12, 3)
  amountInWordsEn   String
  amountInWordsAr   String?
  paidAmount        Decimal       @default(0) @db.Decimal(12, 3)
  dueAmount         Decimal       @default(0) @db.Decimal(12, 3)
  status            String        @default("PAID")
  checkedBy         String?
  createdBy         String
  isDeleted         Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  items             InvoiceItem[]
  payments          Payment[]

  @@index([invoiceNo])
  @@index([customerId])
  @@index([dateTime])
}

model InvoiceItem {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  itemCodeSnap String
  nameEnSnap   String
  nameArSnap   String
  qty          Int
  price        Decimal  @db.Decimal(12, 3)
  lineDiscount Decimal  @default(0) @db.Decimal(12, 3)
  amount       Decimal  @db.Decimal(12, 3)
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  mode      String
  amount    Decimal  @db.Decimal(12, 3)
  reference String?
  date      DateTime @default(now())
}

model Purchase {
  id         String   @id @default(cuid())
  purchaseNo String   @unique
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  date       DateTime @default(now())
  total      Decimal  @db.Decimal(12, 3)
  notes      String?
  createdAt  DateTime @default(now())
  items      Json
}

model StockMovement {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  type      String
  qty       Int
  refType   String?
  refId     String?
  note      String?
  createdBy String
  createdAt DateTime @default(now())
}

model Settings {
  id               String   @id @default("main")
  companyNameEn    String
  companyNameAr    String
  addressEn        String
  addressAr        String
  phone            String
  email            String
  poBox            String?
  logo             String?
  qrCode1          String?
  qrCode2          String?
  declarationEn    String
  declarationAr    String
  invoicePrefix    String   @default("")
  currentInvoiceNo Int      @default(1000)
  currency         String   @default("KD")
  decimals         Int      @default(3)
  taxEnabled       Boolean  @default(false)
  taxPercent       Decimal  @default(0)
  primaryColor     String   @default("#1e3a8a")
  accentColor      String   @default("#f97316")
  updatedAt        DateTime @updatedAt
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model FeatureToggles {
  id                  String   @id @default("main")
  // Sidebar Modules
  enablePos           Boolean  @default(true)
  enableInvoices      Boolean  @default(true)
  enableProducts      Boolean  @default(true)
  enableCategories    Boolean  @default(true)
  enableCustomers     Boolean  @default(true)
  enableSuppliers     Boolean  @default(true)
  enablePurchases     Boolean  @default(true)
  enableReports       Boolean  @default(true)
  enableUsers         Boolean  @default(true)
  enableSettings      Boolean  @default(true)
  
  // Sub-Features
  enableQuotations    Boolean  @default(true)
  enableProfitReport Boolean  @default(true)
  enablePdfExport     Boolean  @default(true)
  enableWhatsapp      Boolean  @default(true)
  
  updatedAt           DateTime @updatedAt
}
